# --- 基础配置 ---
PROJECT_NAME="HID Gateway Platform"
VERSION="1.0.0"
DEBUG=True

# --- MySQL 数据库配置（Docker） ---
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=RootStrongPassword
MYSQL_DB=blue_db

# --- Redis 配置（Docker） ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# --- 安全 / Auth ---
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- 队列后端：memory | redis ---
QUEUE_BACKEND=memory

# --- 跨域配置 ---
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
